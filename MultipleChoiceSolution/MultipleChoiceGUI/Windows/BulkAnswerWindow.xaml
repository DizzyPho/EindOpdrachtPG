<Window x:Class="MultipleChoiceGUI.Windows.BulkAnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultipleChoiceGUI.Windows"
        mc:Ignorable="d"
        Title="Bulk Input" Height="450" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Bulk Antwoorden Ingeven" Grid.Row="0" Margin="8"></Label>
        <TextBox Margin="8" Grid.Row="1" TextWrapping="Wrap" Text="{Binding BulkText}" AcceptsReturn="True"></TextBox>
        <Button Margin="8" Grid.Row="2" Content="Importeren" HorizontalAlignment="Right" Padding="16 4"></Button>
        <Button Margin="8" Grid.Row="2" Content="Terug" HorizontalAlignment="Left" Padding="16 4"></Button>
    </Grid>
</Window>
