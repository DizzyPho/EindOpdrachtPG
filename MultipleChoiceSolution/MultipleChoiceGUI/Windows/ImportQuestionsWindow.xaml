<Window x:Class="MultipleChoiceGUI.Windows.ImportQuestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultipleChoiceGUI.Windows"
        mc:Ignorable="d"
        Title="Importeer vragenlijst" Height="auto" Width="350" SizeToContent="Height">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Nieuwe vragenlijst importeren" Margin="8" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"></Label>
        <TextBox Grid.Row="1" Margin="8" Grid.Column="0" Text="{Binding FilePath}"></TextBox>
        <Button Content="Kies Bestand" Grid.Row="1" Grid.Column="1" Margin="8" Command="{Binding SelectFileCommand}" Padding="8 0"></Button>
        <Label Grid.Row="2" Grid.Column="0"  Content="Kies formaat van bestand" Margin="8"></Label>
        <ItemsControl Grid.Row="3" Grid.ColumnSpan="2" Margin="4" Background="Transparent" 
                  BorderThickness="0" ItemsSource="{Binding FormatOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding Text}" Margin="8" IsChecked="{Binding IsChecked}" GroupName="format"></RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Label Content="Toevoegen aan welk(e) onderwerp(en)?" Margin="8" Grid.Row="4"></Label>
        <ListView ItemsSource="{Binding TopicList}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Topic.Name}" IsChecked="{Binding IsChecked}"></CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="Terug" Grid.Row="6" Grid.Column="0" Margin="8" HorizontalAlignment="Left" Padding="4" Click="ButtonBack_Click"></Button>
        <Button Content="Importeer" Grid.Row="6" Grid.Column="1" Margin="8" Padding="4" Command="{Binding ImportQuestionsCommand}" Click="ButtonImport_Click"></Button>
    </Grid>
</Window>
