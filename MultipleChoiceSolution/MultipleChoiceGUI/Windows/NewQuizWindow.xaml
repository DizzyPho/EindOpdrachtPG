<Window x:Class="MultipleChoiceGUI.Windows.NewQuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultipleChoiceGUI.Windows"
        mc:Ignorable="d"
        Title="Test Genereren" Height="500" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Nieuwe Test Genereren" Grid.Row="0" Grid.ColumnSpan="2" Margin="8"></Label>
        <Label Content="Geef een naam aan de test" Grid.Row="1" Grid.Column="0" Margin="8 8 8 2"></Label>
        <TextBox Grid.ColumnSpan="2" Margin="8 0" Grid.Row="2" Text="{Binding QuestionText}" TextWrapping="Wrap"></TextBox>
        <Label Content="Hoeveel vragen per onderwerp?" Grid.Row="3" Grid.Column="0" Margin="8 8 8 2"></Label>

        <ScrollViewer Grid.Row="4">
            <ItemsControl Margin="8" Background="Transparent" BorderThickness="0" ItemsSource="{Binding TopicList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="4" IsEnabled="False"></CheckBox>
                            <TextBlock Margin="4" Text="{Binding Text}"></TextBlock>
                            <TextBox HorizontalAlignment="Right"></TextBox>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="5" Content="Terug" Margin="8" Padding="6" HorizontalAlignment="Left" Click="ButtonBack_Click"></Button>
        <Button Grid.Row="5" Content="Test Genereren" Margin="8" Padding="6" HorizontalAlignment="Right"></Button>
    </Grid>
</Window>
