<Window x:Class="MultipleChoiceGUI.Windows.NewTopicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultipleChoiceGUI.Windows"
        mc:Ignorable="d"
        Title="Nieuw Onderwerp Toevoegen" Height="auto" Width="350" SizeToContent="Height">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Welk onderwerp wil je toevoegen?" Grid.Row="0" Margin="8"></Label>
        <TextBox Grid.Row="1" Margin="8" Text="{Binding TopicName}"></TextBox>
        <Button Grid.Row="2" Content="Toevoegen" Margin="8" HorizontalAlignment="Right" Padding="16 4" 
                Command="{Binding AddNewTopic}" Click="ButtonAdd_Click"></Button>
        <Button Grid.Row="2" Content="Terug" Margin="8" HorizontalAlignment="Left" Padding="16 4" Click="ButtonBack_Click"></Button>
    </Grid>
</Window>
