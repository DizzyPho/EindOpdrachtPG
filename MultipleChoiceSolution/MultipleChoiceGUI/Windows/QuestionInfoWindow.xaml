<Window x:Class="MultipleChoiceGUI.Windows.QuestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultipleChoiceGUI.Windows"
        mc:Ignorable="d"
        Title="Vragen" Height="550" Width="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Content="Onderwerp" Margin="8" VerticalAlignment="Top"></Label>
        <TextBlock Margin="8" Grid.Row="0" Grid.Column="2" Name="LabelQuestion" Text="{Binding QuestionText}" TextWrapping="Wrap"></TextBlock>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="8" SelectedItem="{Binding SelectedTopic}" ItemsSource="{Binding Topics}"  VerticalAlignment="Top"></ComboBox>
        <ListBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" 
                 Margin="8" ItemsSource="{Binding QuestionList}"  SelectedItem="{Binding SelectedQuestion}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding QuestionText}" IsChecked="{Binding IsEnabled}"></CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Grid.Column="2" Grid.Row="1" Margin="8" ItemsSource="{Binding SelectedQuestionAnswers}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Label Content="{Binding Text}"></Label>
                        <Label Content="{Binding Mark}" HorizontalAlignment="Right"></Label>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Grid.Column="2">
            <Button Margin="8" Content="Importeer vragenlijst" Padding="0 4" Click="ImportQuestions_Click"></Button>
            <Button Margin="8" Content="Nieuw onderwerp" Padding="0 4" Click="NewTopic_Click"></Button>
            <Button Margin="8" Content="Nieuwe vraag" Padding="0 4" Click="NewQuestion_Click"></Button>
        </StackPanel>
        <Button Content="Terug" Grid.Column="0" Grid.Row="3" Margin="8" Command="{Binding CloseCommand}"></Button>
    </Grid>
</Window>
